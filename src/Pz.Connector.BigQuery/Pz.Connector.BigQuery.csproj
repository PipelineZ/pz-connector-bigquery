<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Google BigQuery source (Storage Read API, Arrow) and sink (load jobs; append/replace/merge) connector for PipelineZ (pz), served out of process.</Description>
    <!-- Native AOT. PublishAot is set here as well as by PzPackaging: through the NuGet package the
         SDK's derivation lands after restore has already decided whether to pull the ILCompiler
         pack, and a publish without it silently falls back to a non-AOT layout. -->
    <PzPackaging>aot</PzPackaging>
    <PublishAot>true</PublishAot>
    <!-- key_file is a project-relative path. -->
    <PzProjectDirectoryAnchor>true</PzProjectDirectoryAnchor>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pz.Connectors.Sdk" Version="0.6.0" />
    <PackageReference Include="Pz.Connectors.Abstractions" Version="0.6.0" />
    <PackageReference Include="Google.Cloud.BigQuery.Storage.V1" Version="3.19.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pz.Connector.BigQuery.Tests" />
  </ItemGroup>

</Project>
