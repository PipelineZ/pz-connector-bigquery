<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Google BigQuery source (Storage Read API, Arrow) and sink (load jobs; append/replace/merge) connector for PipelineZ (pz), served out of process.</Description>
    <!-- Native AOT. PublishAot is set here as well as by PzPackaging: through the NuGet package the
         SDK's derivation lands after restore has already decided whether to pull the ILCompiler
         pack, and a publish without it silently falls back to a non-AOT layout. -->
    <PzPackaging>aot</PzPackaging>
    <PublishAot>true</PublishAot>
    <!-- key_file is a project-relative path. -->
    <PzProjectDirectoryAnchor>true</PzProjectDirectoryAnchor>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pz.Connectors.Sdk" Version="0.6.0" />
    <PackageReference Include="Pz.Connectors.Abstractions" Version="0.6.0" />
    <PackageReference Include="Google.Cloud.BigQuery.Storage.V1" Version="3.19.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pz.Connector.BigQuery.Tests" />
  </ItemGroup>

  <!-- First-party code is held to zero trim/AOT warnings by the compile-time analyzers under
       TreatWarningsAsErrors; what is demoted here is only the ILC-stage per-assembly rollup
       (IL2104/IL3053) for the Storage Read API's own dependency stack: Google.Apis.Core and
       Google.Api.Gax.Grpc's internals, and the Newtonsoft.Json they pull in for request/response DTO
       serialization, third-party code whose warnings cannot be fixed from this repository (same
       precedent as pz's own Pz.Cli.csproj for the identical Google/Newtonsoft stack). -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
    <MSBuildWarningsNotAsErrors>$(MSBuildWarningsNotAsErrors);IL2104;IL3053</MSBuildWarningsNotAsErrors>
  </PropertyGroup>

</Project>
